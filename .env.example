# MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster.mongodb.net/folio_db?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/folio_notebook?retryWrites=true&w=majority"

# JWT Secret for Signing Authentication Tokens
JWT_SECRET="folio_super_secure_jwt_secret_key_change_me_in_production_2026"

# Server Port (Default: 3000 in AI Studio environment)
PORT=3000

# Client API URL (Relative /api works natively with the full-stack server)
VITE_API_URL="/api"
